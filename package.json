{
  "name": "routeproof",
  "version": "0.1.0",
  "description": "Audit the real navigation health of modern web applications.",
  "author": "Mike Attal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mike71021/routeproof.git"
  },
  "bugs": {
    "url": "https://github.com/Mike71021/routeproof/issues"
  },
  "homepage": "https://github.com/Mike71021/routeproof#readme",
  "type": "module",
  "bin": {
    "routeproof": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": ["spa", "routes", "crawler", "playwright", "ci", "deep-link", "testing"],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@playwright/test": "^1.55.0",
    "commander": "^14.0.0",
    "jiti": "^2.5.1",
    "picocolors": "^1.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
